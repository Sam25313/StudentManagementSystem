@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Profile";
}

<h2>Student Profile</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<dl class="row">
    <dt class="col-sm-3">Admission Number</dt>
    <dd class="col-sm-9">@Model.AdmissionNumber</dd>

    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">
        @Model.FirstName @Model.MiddleName @Model.LastName
    </dd>

    <dt class="col-sm-3">Date of Birth</dt>
    <dd class="col-sm-9">
        @Model.DateOfBirth.ToString("dd MMM yyyy")
    </dd>

    <dt class="col-sm-3">Student Type</dt>
    <dd class="col-sm-9">@Model.StudentType</dd>

    <dt class="col-sm-3">Admission Date</dt>
    <dd class="col-sm-9">
        @Model.AdmissionDate.ToString("dd MMM yyyy")
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

@if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
{
    <img src="@Model.PhotoPath"
         alt="Student photo"
         style="max-width:160px; max-height:160px; object-fit:cover;" />
}

<h3>Guardians</h3>

@if (!Model.Guardians.Any())
{
    <p>No guardians have been linked to this student yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Relationship</th>
                <th>Primary Contact</th>
                <th>Emergency Contact</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var link in Model.Guardians)
            {
                <tr>
                    <td>@link.Guardian.FullName</td>
                    <td>@link.Guardian.PhoneNumber</td>
                    <td>@link.Relationship</td>
                    <td>@(link.IsPrimaryContact ? "Yes" : "No")</td>
                    <td>@(link.IsEmergencyContact ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">
    Back to Students
</a>

@if (Model.Status == StudentManagementSystem.Models.SchoolEnums.StudentStatus.Active)
{
    <form asp-action="Withdraw"
          asp-route-id="@Model.StudentId"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-warning">
            Mark as Withdrawn
        </button>
    </form>
}
