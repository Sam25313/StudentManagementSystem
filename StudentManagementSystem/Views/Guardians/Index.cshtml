@model IEnumerable<StudentManagementSystem.Models.Guardian>

@{
    ViewData["Title"] = "Guardians";
}

<h2>Guardian Management</h2>

<p>
    <a asp-controller="Guardians"
       asp-action="Create"
       class="btn btn-primary">
        Register New Guardian
    </a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No guardians have been registered yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Phone Number</th>
                <th>Alternative Phone</th>
                <th>Email</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var guardian in Model)
            {
                <tr>
                    <td>@guardian.FullName</td>
                    <td>@guardian.PhoneNumber</td>
                    <td>@(guardian.AlternativePhone ?? "N/A")</td>
                    <td>@(guardian.Email ?? "N/A")</td>
                    <td>@(guardian.Address ?? "N/A")</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@guardian.GuardianId"
                           class="btn btn-sm btn-info">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

